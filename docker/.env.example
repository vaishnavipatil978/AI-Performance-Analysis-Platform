# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here
DB_HOST=postgres
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# JWT (generate a base64-encoded 256-bit key)
# Example: openssl rand -base64 32
JWT_SECRET=your_base64_jwt_secret_here

# Config Server
CONFIG_PASSWORD=config-secret
CONFIG_SERVER_HOST=config-server

# Eureka
EUREKA_HOST=discovery-server

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# AI — get your key from https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-key-here
AI_MODEL=anthropic/claude-3.5-sonnet

# File storage (path inside containers)
UPLOAD_DIR=/app/uploads
